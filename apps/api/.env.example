NODE_ENV=development
PORT=3001

# Local Postgres started via `docker compose up -d` at the repo root
# (see docker-compose.yml). User/password/db match that file.
#
# Migration-time connection — the table-owning superuser. drizzle.config.ts
# (drizzle-kit generate/migrate) uses this one.
DATABASE_URL=postgresql://trellis:trellis@localhost:5432/trellis

# Runtime connection — the non-superuser `app_user` role created in
# drizzle/0002_tenancy_and_rls.sql. apps/api's Fastify server (db/client.ts)
# uses this one, so Row-Level Security policies are actually enforced
# instead of silently bypassed for a table-owning/superuser connection.
# Dev-only password, matches the one hardcoded in that migration file.
APP_DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:5432/trellis

# Must match the Vite dev server origin so the browser can call /health
# and so the session cookie is accepted cross-origin (server.ts sets
# credentials: true on CORS for this reason).
CORS_ORIGIN=http://localhost:5173
